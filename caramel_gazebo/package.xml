<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caramel_gazebo</name>
  <version>0.0.0</version>
  <description>Pacote de simulação do Caramel no Ignition Gazebo</description>
  <maintainer email="brenda.s1602@outlook.com">Cimatec</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Dependências para Ignition Gazebo -->
  <depend>ros_ign_gazebo</depend>
  <depend>ros_ign_gazebo_demos</depend>
  <depend>ign_ros2_control</depend>
  <depend>ign_ros2_control_demos</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_ign_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
